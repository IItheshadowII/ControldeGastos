{
  "expo": {
    "name": "Finance AI",
    "slug": "finance-ai",
    "version": "1.2.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "scheme": "financeai",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.accesoit.financeai",
      "versionCode": 3,
      "adaptiveIcon": {
        "backgroundColor": "#050607",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "runtimeVersion": {
        "policy": "appVersion"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Permitir que Finance AI use la cámara para escanear tickets",
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": false
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "06fcb1db-07c3-4f53-8019-12b17daa7946"
      }
    },
    "owner": "ebanega",
    "updates": {
      "url": "https://u.expo.dev/06fcb1db-07c3-4f53-8019-12b17daa7946"
    }
  }
}
